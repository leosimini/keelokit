{
  "name": "{{ project_slug }}",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "pnpm --filter \"./packages/**\" --if-present build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm -r --if-present e2e",
{%- if 'api' in apps and ('web' in apps or 'mobile' in apps) %}
    "e2e:stack": "pnpm -r --workspace-concurrency=1 run e2e:stack",
{%- endif %}
{%- for app in apps %}
    "dev:{{ app }}": "pnpm --filter ./apps/{{ app }} dev",
{%- endfor %}
{%- if 'mobile' in apps %}
    "run:local": "bash .keelokit/bin/run-local.sh",
{%- endif %}
    "verify": "bash scripts/verify.sh",
    "mutation": "bash scripts/mutation.sh",
    "doctor": "python3 .keelokit/bin/doctor.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
