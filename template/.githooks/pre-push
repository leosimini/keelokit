#!/usr/bin/env sh
# Nothing reaches the remote without passing the same gates as CI. Never bypass with --no-verify.
#
# Git lists what is pushed on stdin, "<local ref> <local sha> <remote ref> <remote sha>" per line.
# 1. A push of nothing but the [verify] shared_seals branch of .keelokit/state.toml (Harbor's
#    logbook), whose commits hold only seal files backed by a green run here, has nothing to verify
#    (verify_tools.py seal-branch-only checks all of that).
# 2. `pnpm verify` checks the checked-out commit and its working tree, so it vouches only for a push
#    of HEAD: a deletion (an all-zero local sha) pushes nothing. Any other commit is refused, so
#    `git push origin <sha>:main` can't land a commit no verify saw, except on a branch that isn't
#    main, master or release, when that exact commit already passed a clean, full verify here
#    against origin/main as it is now (verify_tools.py proven).
# 3. With [verify] wip_branches = "wip/" (as origin/main's state.toml sets it), a push to wip/<topic>
#    carries unfinished work between sessions: it runs no verify and says it can't land. So does a push
#    to archive/<id>-<date>, where `ledger.py drop` keeps an abandoned attempt (always unverified). Any
#    other push is refused while it holds such a tip that origin/main lacks and no green verify here proved.
command -v python3 >/dev/null 2>&1 || { echo 'Keelokit: python3 not found, so the pre-push hook cannot check this push. Install Python 3.11+.' >&2; exit 1; }
refs=
[ -t 0 ] || refs=$(cat)
if [ -n "$refs" ] && printf '%s\n' "$refs" | python3 .keelokit/bin/verify_tools.py seal-branch-only "$1" "$2" 2>/dev/null; then
  echo 'pre-push: only the shared-seals branch, which holds no code: nothing to verify.'
  exit 0
fi
head=$(git rev-parse --verify --quiet HEAD) || head=
# The unverified prefixes, space-separated: wip_branches (when set) and archive/.
prefixes=$(python3 .keelokit/bin/verify_tools.py unverified-prefixes "$1" "$2" </dev/null) || prefixes=archive/
# unverified REF: print the prefix (without its slash) when REF is a branch under one of them.
unverified() {
  for prefix in $prefixes; do
    case $1 in "refs/heads/$prefix"*) printf '%s\n' "${prefix%/}"; return 0 ;; esac
  done
  return 1
}
pushed=0 refused=0 lines=0 heads=0
# Every unverified tip of this push is remembered before any other line is checked: a main listed first
# can't carry wip work the same push is only now putting on the remote.
while read -r local_ref local_sha remote_ref remote_sha; do
  kind=$(unverified "$remote_ref") || continue
  case $local_sha in *[!0]*) ;; *) continue ;; esac
  python3 .keelokit/bin/verify_tools.py wip-record "$(git rev-parse --verify --quiet "$local_sha^{commit}" || echo "$local_sha")" "$kind" </dev/null || true
done <<EOF_WIP
$refs
EOF_WIP
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  lines=$((lines + 1))
  case $local_sha in *[!0]*) ;; *) continue ;; esac
  pushed=$((pushed + 1))
  # A tag pushes the commit it names: an annotated tag on HEAD pushes HEAD.
  commit=$(git rev-parse --verify --quiet "$local_sha^{commit}") || commit=$local_sha
  if kind=$(unverified "$remote_ref"); then
    echo "pre-push: $remote_ref is $kind work: not verified, and it can't land until a commit that holds it passes a verify."
    continue
  fi
  if found=$(python3 .keelokit/bin/verify_tools.py wip-inside "$1" "$commit" "$2" </dev/null); then
    refused=$((refused + 1))
    kind=${found##* } tip=${found% *}
    echo "pre-push: $remote_ref would get unverified $kind work ($(printf %.7s "$tip"), not on origin/main): run pnpm verify on this commit (green and clean, it covers the $kind work in it), then push again." >&2
    continue
  fi
  if [ "$commit" = "$head" ]; then heads=$((heads + 1)); continue; fi
  case $remote_ref in
    refs/heads/main | refs/heads/master | refs/heads/release) ;;
    *)
      if python3 .keelokit/bin/verify_tools.py proven "$1" "$commit" "$2" </dev/null; then
        echo "pre-push: $remote_ref gets $(printf %.7s "$commit"), which already passed a clean, full verify here against origin/main: not run again."
        continue
      fi
      ;;
  esac
  refused=$((refused + 1))
  echo "pre-push: $remote_ref would get $(printf %.7s "$commit") ($local_ref), not the checked-out commit $(printf %.7s "${head:-none}")." >&2
done <<EOF
$refs
EOF
if [ "$refused" -gt 0 ]; then
  echo "pre-push: refused. pnpm verify checks the checked-out commit, so it can't vouch for one pushed from elsewhere: check it out and push from there (git switch <branch>, or git checkout <sha>). A commit that already passed is skipped by its seal." >&2
  exit 1
fi
# The trunk's attribution (LEDGER-010, INV-007) comes before the verify: it is the fast part. ledger.py prepush
# checks only a push to the trunk (nothing unattributed, a merge attributes what it brings, a squash keeps its
# branch's trailers) and refuses under [ledger] enforce = "block"; when it cannot run, the CI checks the same.
if [ -n "$refs" ] && [ -f .keelokit/bin/ledger.py ]; then
  printf '%s\n' "$refs" | python3 .keelokit/bin/ledger.py prepush "$1" "$2"
  case $? in
    0) ;;
    1) exit 1 ;;
    *) echo 'pre-push: ledger.py could not check the attribution of this push; the CI checks it again.' >&2 ;;
  esac
fi
# Only deletions, or only commits already proven: nothing to verify. No lines at all (the hook run by
# hand): verify HEAD, as before.
[ "$lines" -eq 0 ] || [ "$heads" -gt 0 ] || exit 0
# The verify compares with main as it is where this push goes ($2), not wherever origin's fetch URL points.
KEELOKIT_PUSH_URL=$2 exec pnpm verify --use-seal
