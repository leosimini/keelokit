{% raw %}# Fail-fast pipeline: secrets -> checks -> tests -> integration -> build -> deploy (main only).
# Same gates as `pnpm verify` (scripts/verify.sh), which runs them locally before every push;
# .keelokit/verify-map.toml says which verify step is which job (the doctor checks it, CI-2).
#
# The local gate decides and this file audits: besides pushes and pull requests it runs every night
# and by hand (Actions > CI > Run workflow, or `python3 .keelokit/bin/ci.py dispatch`). To bill
# minutes only for the audit, delete the `pull_request` and `push` triggers (docs/ci.md).
#
# Time budget (CI-1). Jobs are split by kind of test: cheap checks, unit, UI/mobile journeys, and
# integration with the database, each with its own `timeout-minutes`. A job that nears its timeout
# is not 'failed' but 'cancelled', and the last job (ci-report) prints each job's share of its
# budget and the 10 slowest tests in the run summary. NEVER raise a timeout to fix a slow job:
# split it by kind of test, or shard it (docs/ci.md). The doctor fails when a timeout grows.
# API-only jobs are rendered only when the API exists (GitHub rejects hashFiles in a job-level
# `if`); adding an app is a `copier update`, which re-renders this file.
name: CI

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  schedule:
    - cron: '17 5 * * *' # the nightly audit of main
  workflow_dispatch:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read

jobs:
  secrets:
    name: Secret scan
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      # The gitleaks CLI (free), not gitleaks-action (needs a paid license on organisation repos).
      - name: gitleaks (full history)
        run: docker run --rm -v "$PWD:/repo" ghcr.io/gitleaks/gitleaks:v8.30.1 git --redact --no-banner /repo

  checks:
    name: Format, lint, typecheck, doctor, audit
    needs: secrets
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0 # origin/main: the doctor counts a story done only from main (INV-005)
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - name: Prisma client
        if: hashFiles('apps/api/prisma/schema.prisma') != ''
        run: pnpm --filter ./apps/api prisma:generate
      - run: pnpm format:check
      - run: pnpm lint
      - run: pnpm typecheck
      - name: Harness doctor
        run: python3 .keelokit/bin/doctor.py --ci
      - name: Dependency audit
        run: python3 .keelokit/bin/audit.py

  unit:
    name: Unit tests
    needs: checks
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - name: Prisma client
        if: hashFiles('apps/api/prisma/schema.prisma') != ''
        run: pnpm --filter ./apps/api prisma:generate
      - run: pnpm test
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: timings-unit
          path: ci-timings
          if-no-files-found: ignore

{% endraw %}{% if 'api' in apps %}{% raw %}  integration:
    name: Integration tests (real PostgreSQL)
    needs: unit
    runs-on: ubuntu-latest
    timeout-minutes: 15
    services:
      postgres:
        image: {% endraw %}{{ 'postgis/postgis:16-3.4' if postgis else 'postgres:16' }}{% raw %}
        env:
          POSTGRES_USER: app
          POSTGRES_PASSWORD: app
          POSTGRES_DB: app
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U app -d app" --health-interval 5s --health-timeout 5s
          --health-retries 20
    env:
      DATABASE_URL: postgresql://app:app@localhost:5432/app
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm --filter ./apps/api prisma:generate
      - run: pnpm --filter ./apps/api prisma:migrate:deploy
      - run: pnpm --filter ./apps/api db:seed
      - run: pnpm --filter ./apps/api test:integration
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: timings-integration
          path: ci-timings
          if-no-files-found: ignore

{% endraw %}{% endif %}{% raw %}  # E2E-1: each app's `e2e` script builds, serves and walks its critical journeys (hermetic:
  # the API is mocked at the network layer, so this job needs no database).
  e2e:
    name: End-to-end journeys
    needs: unit
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      # One app at a time: parallel `playwright install --with-deps` runs collide on apt's lock.
      - run: pnpm -r --workspace-concurrency=1 --if-present e2e:install
      - run: pnpm e2e
      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: e2e-report
          path: apps/*/playwright-report
          if-no-files-found: ignore
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: timings-e2e
          path: ci-timings
          if-no-files-found: ignore

{% endraw %}{% if 'api' in apps and ('web' in apps or 'mobile' in apps) %}{% raw %}  # E2E-2: the critical journeys again, against the real API and PostgreSQL — no network mocks.
  e2e-stack:
    name: End-to-end on the real stack
    needs: unit
    runs-on: ubuntu-latest
    timeout-minutes: 25
    services:
      postgres:
        image: {% endraw %}{{ 'postgis/postgis:16-3.4' if postgis else 'postgres:16' }}{% raw %}
        env:
          POSTGRES_USER: app
          POSTGRES_PASSWORD: app
          POSTGRES_DB: app
        ports: ['5432:5432']
        options: >-
          --health-cmd "pg_isready -U app -d app" --health-interval 5s --health-timeout 5s
          --health-retries 20
    env:
      DATABASE_URL: postgresql://app:app@localhost:5432/app
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm --filter ./apps/api prisma:generate
      - run: pnpm --filter ./apps/api prisma:migrate:deploy
      - run: pnpm --filter ./apps/api db:seed
      - run: pnpm -r --workspace-concurrency=1 --if-present e2e:install
      - run: pnpm e2e:stack
      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: e2e-stack-report
          path: apps/*/playwright-report
          if-no-files-found: ignore
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: timings-e2e-stack
          path: ci-timings
          if-no-files-found: ignore

{% endraw %}{% endif %}{% raw %}  # MUT-1: mutate the critical code (.keelokit/critical.toml) and fail under its threshold. A pull
  # request mutates the critical files it changes; main mutates all of them.
  mutation:
    name: Mutation testing (critical code)
    needs: unit
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0 # origin/main, to find the critical files a pull request changes
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - name: Prisma client
        if: hashFiles('apps/api/prisma/schema.prisma') != ''
        run: pnpm --filter ./apps/api prisma:generate
      - run: pnpm mutation ${{ contains(fromJSON('["push", "schedule"]'), github.event_name) && '--all' || '' }}
      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: mutation-report
          path: '**/reports/mutation/'
          if-no-files-found: ignore

  # SAST-1: static analysis for injection, unsafe APIs and hard-coded secrets.
  sast:
    name: Static analysis (Semgrep)
    needs: secrets
    runs-on: ubuntu-latest
    timeout-minutes: 10
    container:
      image: semgrep/semgrep:1.178.0
    steps:
      - uses: actions/checkout@v4
      - run: semgrep scan --config p/typescript --config p/react --config p/secrets --error --metrics=off

  build:
    name: Build
    needs: unit
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version-file: .nvmrc
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - name: Prisma client
        if: hashFiles('apps/api/prisma/schema.prisma') != ''
        run: pnpm --filter ./apps/api prisma:generate
      - run: pnpm build

  # Time per job against its timeout, the 10 slowest tests, and how many runs main has gone without
  # a green (a 'cancelled' run is not green). Never fails the run: it only reports.
  ci-report:
    name: Run report (time per job, slowest tests)
    needs: [secrets, checks, unit, {% endraw %}{% if 'api' in apps %}integration, {% endif %}{% raw %}e2e, {% endraw %}{% if 'api' in apps and ('web' in apps or 'mobile' in apps) %}e2e-stack, {% endif %}{% raw %}mutation, sast, build]
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      actions: read
      contents: read
    env:
      GITHUB_TOKEN: ${{ github.token }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/download-artifact@v4
        continue-on-error: true # no test job uploaded timings (they were skipped)
        with:
          pattern: timings-*
          path: ci-timings
          merge-multiple: true
      - run: python3 .keelokit/bin/ci.py summary --tests ci-timings
      - name: Main without a green run?
        if: github.ref == 'refs/heads/main'
        run: |
          python3 .keelokit/bin/ci.py health | tee -a "$GITHUB_STEP_SUMMARY" ||
            echo "::warning title=CI health::main has runs without a green one (cancelled counts); see the run summary"{% endraw %}{% if 'api' in apps %}{% raw %}

  # Staging deploys on every green main. It is a hard failure (never continue-on-error): a red
  # staging must be seen. Until the FLY_API_TOKEN secret exists the job skips itself, and
  # `pnpm run doctor` keeps listing that as an open setup step.
  deploy-staging:
    name: Deploy API to staging (Fly.io)
    needs: [integration, build, e2e, {% endraw %}{% if 'web' in apps or 'mobile' in apps %}e2e-stack, {% endif %}{% raw %}sast]
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: staging
    env:
      FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
    steps:
      - uses: actions/checkout@v4
      - name: Skip when Fly is not configured yet
        id: fly
        run: echo "ready=$([ -n "$FLY_API_TOKEN" ] && echo yes || echo no)" >> "$GITHUB_OUTPUT"
      - uses: superfly/flyctl-actions/setup-flyctl@ed8efb33836e8b2096c7fd3ba1c8afe303ebbff1 # 1.6
        if: steps.fly.outputs.ready == 'yes'
      - if: steps.fly.outputs.ready == 'yes'
        run: flyctl deploy --config apps/api/fly.staging.toml --remote-only{% endraw %}{% endif %}
