{
  "name": "@{{ project_slug }}/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
{%- if 'api' in apps %}
    "e2e": "EXPO_PUBLIC_API_URL=http://api.test expo export --platform web --clear && playwright test",
    "e2e:stack": "pnpm --dir ../api build && EXPO_PUBLIC_API_URL=http://localhost:${E2E_API_PORT:-3100} expo export --platform web --clear && playwright test -c playwright.stack.config.ts",
{%- else %}
    "e2e": "expo export --platform web && playwright test",
{%- endif %}
    "e2e:install": "playwright install --with-deps --only-shell chromium"
  },
  "dependencies": {
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@{{ project_slug }}/shared": "workspace:*",
    "@{{ project_slug }}/ui-tokens": "workspace:*",
    "expo": "~57.0.25",
    "expo-localization": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "~1.2.0"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  }
}
