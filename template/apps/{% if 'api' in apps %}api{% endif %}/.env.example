# Copy to .env (gitignored) for local runs. Every key the API reads; src/config/env.schema.ts
# says which are required and what the optional ones default to.

# PostgreSQL from docker-compose.yml.
DATABASE_URL=postgresql://app:app@localhost:5432/app
# development | test | staging | production. staging and production log JSON lines.
NODE_ENV=development
# Port the API listens on.
PORT=3000
# Comma-separated browser origins allowed to call the API (the web app in dev). Empty allows none.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Sentry project DSN. Empty disables error reporting.
SENTRY_DSN=
# verbose | debug | log | warn | error | fatal
LOG_LEVEL=log
