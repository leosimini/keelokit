packages:
  - 'apps/*'
  - 'packages/*'

# Dependencies allowed to run install scripts (pnpm 10 blocks them by default).
onlyBuiltDependencies:
  - esbuild
{%- if 'api' in apps %}
  # api:start
  - '@prisma/engines'
  - prisma
  # api:end
{%- endif %}
{%- if 'web' in apps or 'site' in apps %}
  # web-site:start
  # web-site:end
{%- endif %}
{%- if 'mobile' in apps %}
  # mobile:start
  # mobile:end
{%- endif %}
{%- if 'api' in apps or 'mobile' in apps %}

# Pinned dependencies carrying high advisories that have a fix (SEC-3): a new advisory turns the audit red
# with no code change, so the override goes in and comes out once the tool ships the fixed version itself.
# ponytail: drop each override once its owner ships the fixed version.
overrides:
{%- if 'api' in apps %}
  'prisma>mysql2': ^3.23.1
  '@prisma/config>deepmerge-ts': ^8.0.2
{%- endif %}
{%- if 'mobile' in apps %}
  '@expo/cli>zod': ^4.6.6
{%- endif %}
{%- endif %}
